;; Set customize file
(setq custom-file "~/.config/emacs/.emacs.custom.el")
(load custom-file 'noerror)

(add-to-list 'load-path "~/.config/emacs/.emacs.local/")

(require 'package)
;; Please load file before the package-initialize
(package-initialize)

(load "~/.config/emacs/customize.rc/theme.rc.el")

;; Set config
(tool-bar-mode 0)
(menu-bar-mode 0)
(scroll-bar-mode 0)
(column-number-mode 1)
(setq-default tab-width 4)
(electric-pair-mode 1)


;; Work around libgccjit/GCC incorrectly deriving
;; -mmacosx-version-min=18.0 on newer macOS.
(when (eq system-type 'darwin)
  (setenv "MACOSX_DEPLOYMENT_TARGET" "15.0"))

;; Switch macOS input method to English when Emacs gets focus
(defun my/switch-to-english-input ()
  (when (eq system-type 'darwin)
    (call-process
     "/opt/homebrew/bin/macism"
     nil 0 nil
     "com.apple.keylayout.ABC")))

(add-hook 'focus-in-hook #'my/switch-to-english-input)


;;; multiple cursors
(rc/require 'multiple-cursors)

(global-set-key (kbd "C-S-c C-S-c") 'mc/edit-lines)
(global-set-key (kbd "C->")         'mc/mark-next-like-this)
(global-set-key (kbd "C-<")         'mc/mark-previous-like-this)
(global-set-key (kbd "C-c C-<")     'mc/mark-all-like-this)
(global-set-key (kbd "C-\"")        'mc/skip-to-next-like-this)
(global-set-key (kbd "C-:")         'mc/skip-to-previous-like-this)

;;; ============================================================
;;; Paredit
;;; ============================================================
(rc/require 'paredit)
(require 'paredit)
(add-hook 'emacs-lisp-mode-hook #'paredit-mode)
(add-hook 'lisp-mode-hook #'paredit-mode)
(add-hook 'scheme-mode-hook #'paredit-mode)

;;; fasm-mode
(require 'fasm-mode)
(add-to-list 'auto-mode-alist '("\\.asm\\'" . fasm-mode))

;;; Move Text
(rc/require 'move-text)
(global-set-key (kbd "M-p") 'move-text-up)
(global-set-key (kbd "M-n") 'move-text-down)

(set-frame-parameter nil 'alpha 95)
(add-to-list 'default-frame-alist '(alpha . 95))

(rc/require-theme 'gruber-darker)
